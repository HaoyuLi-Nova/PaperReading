%% RoboScience Research Paper Style
%% A compact, arXiv-friendly style for RoboScience papers.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rbs}[2026/10/21 RoboScience paper style]

\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{natbib}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{microtype}

\DeclareOption{anonymous}{\rbs@anonymoustrue}
\DeclareOption{submission}{\rbs@anonymoustrue}
\DeclareOption{final}{\rbs@anonymousfalse}
\DeclareOption{preprint}{\rbs@anonymousfalse}
\newif\ifrbs@anonymous
\rbs@anonymousfalse
\ProcessOptions\relax

\definecolor{rbsGreen}{HTML}{52CCBA}
\definecolor{rbsMint}{HTML}{EAF8F5}
\definecolor{rbsMintDark}{HTML}{D4F1EA}
\definecolor{rbsInk}{HTML}{101817}
\definecolor{rbsGray}{HTML}{5B6866}
\definecolor{rbsRule}{HTML}{B7DCD4}

\geometry{letterpaper,top=0.82in,bottom=0.82in,left=0.86in,right=0.86in,headheight=16pt,headsep=0.20in,footskip=0.34in}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.42em}
\setlength{\emergencystretch}{2em}
\linespread{1.02}
\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}
\renewcommand{\topfraction}{0.95}
\renewcommand{\textfraction}{0.05}
\renewcommand{\floatpagefraction}{0.8}
\clubpenalty=10000
\widowpenalty=10000

