@phdthesis{dingJiyushenduxuexideshijuewendafangfayuxitongyanjiu2019,
  type = {{硕士}},
  title = {{基于深度学习的视觉问答方法与系统研究}},
  author = {丁, 月明},
  year = {2019},
  urldate = {2019-11-05},
  abstract = {视觉问答任务是一个结合自然语言处理与计算机视觉研究的交叉学科。视觉问答系统针对提出的问题,从与问题相关的图像中找寻有用信息对问题进行正确回答。视觉问答任务模型包含了图像的特征提取,文本的特征提取,注意力机制,多模态特征融合以及答案生成几个模块。而目前的主要研究集中在特征的优化,注意力机制的改进以及多模态特征融合方式等方面,而研究的难点多在于图像特征不能很好的表征场景与物体信息,文本特征表征不完善以及图像特征会引入噪声或冗余信息等,而本文将就这些不足之处进行如下研究:首先是针对特征表示的问题,本文采用了多尺度特征提取及融合方法来完善图像信息的表征。常用的图像特征表示多采用神经网络提取图像特征,由此得到的特征具有高级的语义信息但存在着细节信息不足的问题,因此在视觉问答任务中表现欠缺。本文对此不足做出改进,首先采用预训练的深度神经网络提取不同层次网络输出的图像特征,之后对特征进行融合方式的研究找寻最优的融合方式。对于句子的表征,本文也引入多尺度特征方法,对句子的单词层次,短语层次以及句子层次的特征进行了表征与融合。对于因使用完整特征导致网络引入噪声或信息过于冗余的问题,本文改进了注意力机制方法,提出了改进混合注意力机制。该注意力机制结合了空间注意力机制方法以及通道注意力机制方法,针于注意力机制会对原始特征造成损耗的情况,本文在该注意力机制中加入了少部分的图像特征作为补偿。而对于文本特征的注意力机制,本文引入了自注意力机制的方法,尝试通过强化句子内部结构特征而对模型整体进行提升。最后本文融合多尺度特征技术以及改进混合注意力机制方法对视觉问答模型进行改进,并在实验中发现,多尺度特征技术与针对图像特征提出的改进混合注意力机制的结合使用对视觉问答模型有较为明显的提升效果。},
  langid = {chinese},
  school = {电子科技大学},
  file = {C\:\\Users\\chewu\\Zotero\\storage\\7W23JLMJ\\基于深度学习的视觉问答方法与系统研究_丁月明.caj}
}

