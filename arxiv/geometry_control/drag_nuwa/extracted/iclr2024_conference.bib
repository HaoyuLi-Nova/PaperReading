@article{xuCanYouFool2017,
  title = {Can You Fool {{AI}} with Adversarial Examples on a Visual {{Turing}} Test?},
  author = {Xu, Xiaojun and Chen, Xinyun and Liu, Chang and Rohrbach, Anna and Darell, Trevor and Song, Dawn},
  year = {2017},
