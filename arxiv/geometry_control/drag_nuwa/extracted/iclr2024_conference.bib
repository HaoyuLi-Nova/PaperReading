  author = {Sharma, Prafull and Tewari, Ayush and Du, Yilun and Zakharov, Sergey and Ambrus, Rares and Gaidon, Adrien and Freeman, William T. and Durand, Fredo and Tenenbaum, Joshua B. and Sitzmann, Vincent},
  year = {2022},
