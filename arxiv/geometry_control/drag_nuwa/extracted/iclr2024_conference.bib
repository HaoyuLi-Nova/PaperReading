@misc{gandikotaErasingConceptsDiffusion2023,
  title = {Erasing {{Concepts}} from {{Diffusion Models}}},
  author = {Gandikota, Rohit and Materzynska, Joanna and {Fiotto-Kaufman}, Jaden and Bau, David},
