@misc{niklaus3DKenBurns2019,
  title = {{{3D Ken Burns Effect}} from a {{Single Image}}},
  author = {Niklaus, Simon and Mai, Long and Yang, Jimei and Liu, Feng},
  year = {2019},
  month = sep,
  number = {arXiv:1909.05483},
