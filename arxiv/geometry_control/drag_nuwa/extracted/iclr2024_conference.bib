@article{zhengContentawareGenerativeModeling2019,
  title = {Content-Aware Generative Modeling of Graphic Design Layouts},
  author = {Zheng, Xinru and Qiao, Xiaotian and Cao, Ying and Lau, Rynson W. H.},
