  title = {{{GODIVA}}: {{Generating Open-DomaIn Videos}} from {{nAtural Descriptions}}},
  shorttitle = {{{GODIVA}}},
  author = {Wu, Chenfei and Huang, Lun and Zhang, Qianxi and Li, Binyang and Ji, Lei and Yang, Fan and Sapiro, Guillermo and Duan, Nan},
